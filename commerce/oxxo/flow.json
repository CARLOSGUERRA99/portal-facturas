[
  { "action": "goto",       "url": "{{url}}" },
  { "action": "hook",       "name": "cerrarPopup" },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p1_inicio" },
  { "action": "hook",       "name": "seleccionarFecha" },
  { "action": "hook",       "name": "llenarTicket" },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p2_ticket" },
  { "action": "hook",       "name": "validarTicket" },
  {
    "action": "on",
    "value":  "resultadoValidacion",
    "equals": "folio_no_disponible",
    "steps":  [
      { "action": "hook", "name": "reimprimir" }
    ]
  },
  { "action": "hook",       "name": "llenarDatosFactura" },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p3_datos_fiscales" },
  { "action": "hook",       "name": "generarYEnviar" }
]
