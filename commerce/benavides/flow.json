[
  { "action": "goto",       "url": "{{url}}" },
  { "action": "waitFor",    "selector": "{{selectors.ticket}}", "timeout": 15000 },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p1_inicio" },

  { "action": "fill", "selector": "{{selectors.ticket}}",     "value": "{{folio}}",        "strategy": "js" },
  { "action": "fill", "selector": "{{selectors.total}}",      "value": "{{totalDecimal}}", "strategy": "js" },
  { "action": "fill", "selector": "{{selectors.rfcCliente}}", "value": "{{rfc}}",          "strategy": "js" },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p2_ticket_llenado" },
  { "action": "hook",       "name": "clickSiguiente" },

  { "action": "waitFor",    "selector": "{{selectors.razonSocial}}", "timeout": 20000 },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p3_datos_fiscales" },

  { "action": "fill", "selector": "{{selectors.razonSocial}}", "value": "{{razonSocial}}", "strategy": "js" },
  { "action": "hook", "name": "llenarCodigoPostal" },
  { "action": "fill", "selector": "{{selectors.municipio}}",   "value": "{{municipio}}",   "strategy": "js" },
  { "action": "fill", "selector": "{{selectors.colonia}}",     "value": "{{colonia}}",     "strategy": "js" },
  { "action": "fill", "selector": "{{selectors.calle}}",       "value": "{{calle}}",       "strategy": "js" },
  { "action": "hook", "name": "seleccionarUsoCfdi" },
  { "action": "hook", "name": "seleccionarRegimen" },
  { "action": "hook", "name": "cambiarCorreo" },
  { "action": "screenshot", "key": "debug/{{portal}}_{{ticketId}}_p4_fiscales_llenados" },
  { "action": "hook",       "name": "clickSiguiente" },

  { "action": "hook",       "name": "confirmarYDescargar" }
]
